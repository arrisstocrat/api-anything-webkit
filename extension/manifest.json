{
  "manifest_version": 2,
  "name": "API Anything Connector",
  "version": "0.1.6",
  "description": "Connect this browser to your local API Anything bridge. Experimental; guarded capture is unavailable.",
  "permissions": ["tabs", "storage", "activeTab", "http://127.0.0.1/*"],
  "optional_permissions": ["http://*/*", "https://*/*"],
  "background": {
    "scripts": ["config.js", "session-request.js", "background.js"],
    "persistent": true
  },
  "browser_action": {
    "default_popup": "popup.html"
  },
  "content_security_policy": "script-src 'self'; object-src 'none'; connect-src http://127.0.0.1:*",
  "options_ui": {
    "page": "popup.html",
    "open_in_tab": true
  },
  "web_accessible_resources": ["page-capture.js"]
}
